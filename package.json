{
  "name": "linkedin-blitz-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Encrypted static dashboard for a LinkedIn engagement campaign",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:example": "node scripts/build.mjs --example",
    "serve": "python3 -m http.server 8080 -d docs",
    "test": "node --test tests/*.test.mjs",
    "verify:bundle": "node scripts/check-published.mjs",
    "build:firebase-demo": "node scripts/build-firebase-demo.mjs",
    "verify:firebase-demo": "node scripts/verify-firebase-demo.mjs",
    "build:secure-shell": "node scripts/build-secure-shell.mjs",
    "verify:secure-shell": "node scripts/verify-secure-shell.mjs",
    "test:secure": "node scripts/run-secure-suite.mjs",
    "ingest:synthetic-emulator": "node scripts/ingest-synthetic-emulator.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "^0.25.10",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.5.0",
    "firebase-tools": "^14.22.0",
    "puppeteer-core": "^24.23.0"
  }
}
